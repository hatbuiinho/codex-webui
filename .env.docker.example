# Copy or rename this file to .env, then replace the values marked CHANGE_ME.
# Never commit .env.

# Image/build versions. Keep versions pinned and update intentionally.
CODEX_WEBUI_IMAGE=codex-webui:local
CODEX_VERSION=0.153.0

# Exact HTTPS origin, without a trailing slash.
CODEX_WEBUI_PUBLIC_ORIGIN=https://CHANGE_ME.example.com

# Generate these values as described in docs/docker-deployment.vi.md.
# Keep scrypt hashes single-quoted so dollar signs remain literal.
CODEX_WEBUI_PASSWORD_HASH='CHANGE_ME_ADMIN_SCRYPT_HASH'
CODEX_WEBUI_OWNER_PASSWORD_HASH='CHANGE_ME_OWNER_SCRYPT_HASH'
# Optional read-only login. Leave empty if unused.
CODEX_WEBUI_VIEWER_PASSWORD_HASH=
CODEX_WEBUI_SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES

# One shared profile, many conversations. The owner rotates the ChatGPT account
# only after all active turns and queues have finished.
CODEX_WEBUI_PER_SESSION_APP_SERVERS=false
# "auto" uses CPU/RAM detection and caps the result at 4 app-server processes.
CODEX_WEBUI_MAX_APP_SERVERS=auto
CODEX_WEBUI_APP_SERVER_IDLE_SECONDS=300
CODEX_WEBUI_APP_SERVER_STARTUP_TIMEOUT_SECONDS=10
CODEX_WEBUI_APP_SERVER_TIMEOUT_SECONDS=600

# Image/reference uploads and WebUI-managed attachment storage.
# Files saved directly under ./workspace are not covered by the 10 GB limit.
CODEX_WEBUI_MAX_UPLOAD_MB=50
CODEX_WEBUI_MAX_ATTACHMENT_STORAGE_MB=10240

# Safe defaults for a shared internal workspace.
CODEX_WEBUI_DEFAULT_SANDBOX=workspace-write
CODEX_WEBUI_DEFAULT_APPROVAL_POLICY=on-request
CODEX_WEBUI_DEFAULT_AUTO_APPROVE=manual
CODEX_WEBUI_DEFAULT_NETWORK=true
